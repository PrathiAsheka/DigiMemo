DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
UPLOAD_DIR="./uploads"
ANTHROPIC_API_KEY=""

# Google sign-in (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (and your production URL).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public base URL used to build the redirect URI; defaults to the request origin.
# APP_URL="https://your-domain.example"

# ── AI provider ──────────────────────────────────────────────────────────────
# "anthropic" (default): hosted AI API for document reading, paid per use (set ANTHROPIC_API_KEY above).
# "ollama": a free model running on your own computer (https://ollama.com).
AI_PROVIDER="anthropic"
# Ollama settings (only used when AI_PROVIDER="ollama")
OLLAMA_URL="http://127.0.0.1:11434"
# Must be a vision model so it can read photos of receipts and labels.
OLLAMA_MODEL="qwen2.5vl:3b"
