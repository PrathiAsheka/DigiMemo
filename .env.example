# PostgreSQL. On Vercel, connecting Prisma Postgres (Storage tab) fills this in for you.
# Locally: run `npx prisma dev` and paste the postgres:// URL it prints
# (add pgbouncer=true& right after the ?).
DATABASE_URL="postgres://user:password@localhost:5432/digimemo"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
# Uploaded files: a private Vercel Blob store when this token is set (Vercel fills it in
# when you connect a Blob store), otherwise the local UPLOAD_DIR folder.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"

# Optional: AI document reading (fills in equipment details from receipts and label photos).
# Leave empty to turn it off; everything else works without it.
ANTHROPIC_API_KEY=""

# Google sign-in (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (and your production URL).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public base URL used to build the redirect URI; defaults to the request origin.
# APP_URL="https://your-domain.example"
